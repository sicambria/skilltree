{
    "name": "skilltree",
    "version": "1.0.0",
    "description": "Skill tree web app",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "db:seed": "node src/utils/seed.js",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage --coverageThreshold='{}'",
        "test:frontend": "jest --config jest.frontend.config.js",
        "test:all": "npm test && npm run test:frontend"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "express": "^4.22.2",
        "express-rate-limit": "^8.6.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.24.1",
        "morgan": "^1.11.0"
    },
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "fast-check": "^4.9.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "mongodb-memory-server": "^11.2.0",
        "supertest": "^7.2.2"
    }
}
