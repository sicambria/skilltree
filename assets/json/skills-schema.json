{
  "definitions": {},
  "type": "array",
  "title": "The Root Schema",
  "items": {
    "$id": "#/items",
    "type": "object",
    "title": "The Items Schema",
    "required": [
      "name",
      "categoryName",
      "skillIcon",
      "description",
      "maxPoint",
      "reusability"
    ],
    "properties": {
      "name": {
        "$id": "#/items/properties/name",
        "type": "string",
        "title": "The Name Schema",
        "default": "",
        "examples": [
          "HTML"
        ],
        "pattern": "^(.*)$"
      },
      "categoryName": {
        "$id": "#/items/properties/categoryName",
        "type": "string",
        "title": "The Categoryname Schema",
        "default": "",
        "examples": [
          "MathSciEng",
          "Language",
          "Soft",
          "Entrepreneurship",
          "Culture",
          "Digital",
          "Learning",
          "Other"
        ],
        "pattern": "^(.*)$"
      },
      "skillIcon": {
        "$id": "#/items/properties/skillIcon",
        "type": "string",
        "title": "The Skillicon Schema",
        "default": "pictures/icons/default.png",
        "examples": [
          "pictures/icons/HTML.png"
        ],
        "pattern": "^(.*)$",
        "format": "uri"
      },
      "description": {
        "$id": "#/items/properties/description",
        "type": "string",
        "title": "The Description Schema",
        "default": "",
        "examples": [
          "..."
        ],
        "pattern": "^(.*)$"
      },
      "descriptionWikipediaURL": {
        "$id": "#/items/properties/descriptionWikipediaURL",
        "type": "string",
        "title": "The Descriptionwikipediaurl Schema",
        "default": "",
        "examples": [
          "https://en.wikipedia.org/wiki/"
        ],
        "pattern": "^(.*)$",
        "format": "uri"
      },
      "pointDescription": {
        "$id": "#/items/properties/pointDescription",
        "type": "array",
        "title": "The Pointdescription Schema",
        "default": null,
        "items": {
          "$id": "#/items/properties/pointDescription/items",
          "type": "string",
          "title": "The Items Schema",
          "default": "",
          "examples": [
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ],
          "pattern": "^(.*)$"
        }
      },
      "maxPoint": {
        "$id": "#/items/properties/maxPoint",
        "type": "integer",
        "title": "The Maxpoint Schema",
        "default": 0,
        "examples": [
          5
        ],
        "maximum": 10
      },
      "parents": {
        "$id": "#/items/properties/parents",
        "type": "array",
        "title": "The Parents Schema",
        "default": null
      },
      "children": {
        "$id": "#/items/properties/children",
        "type": "array",
        "title": "The Children Schema",
        "default": null,
        "items": {
          "$id": "#/items/properties/children/items",
          "type": "object",
          "title": "The Items Schema",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "$id": "#/items/properties/children/items/properties/name",
              "type": "string",
              "title": "The Name Schema",
              "default": "",
              "examples": [
                "CSS"
              ],
              "pattern": "^(.*)$"
            },
            "minPoint": {
              "$id": "#/items/properties/children/items/properties/minPoint",
              "type": "integer",
              "title": "The Minpoint Schema",
              "default": 0,
              "examples": [
                1
              ]
            },
            "recommended": {
              "$id": "#/items/properties/children/items/properties/recommended",
              "type": "boolean",
              "title": "The Recommended Schema",
              "default": false,
              "examples": [
                false
              ]
            }
          }
        }
      },
      "trainings": {
        "$id": "#/items/properties/trainings",
        "type": "array",
        "title": "The Trainings Schema",
        "default": null,
        "items": {
          "$id": "#/items/properties/trainings/items",
          "type": "object",
          "title": "The Items Schema",
          "required": [
            "name",
            "level",
            "shortDescription",
            "URL"
          ],
          "properties": {
            "name": {
              "$id": "#/items/properties/trainings/items/properties/name",
              "type": "string",
              "title": "The Name Schema",
              "default": "",
              "examples": [
                "HTML Basics"
              ],
              "pattern": "^(.*)$"
            },
            "level": {
              "$id": "#/items/properties/trainings/items/properties/level",
              "type": "integer",
              "title": "The Level Schema",
              "default": 0,
              "examples": [
                1
              ],
              "minimum": 0,
              "maximum": 10
            },
            "shortDescription": {
              "$id": "#/items/properties/trainings/items/properties/shortDescription",
              "type": "string",
              "title": "The Shortdescription Schema",
              "default": "",
              "examples": [
                "HTML Crash Course For Absolute Beginners"
              ],
              "pattern": "^(.*)$"
            },
            "URL": {
              "$id": "#/items/properties/trainings/items/properties/URL",
              "type": "string",
              "title": "The Url Schema",
              "default": "",
              "examples": [
                "https://www.youtube.com/watch?v=UB1O30fR-EE"
              ],
              "pattern": "^(.*)$"
            },
            "URLlastAccessed": {
              "$id": "#/items/properties/trainings/items/properties/URLlastAccessed",
              "type": "string",
              "title": "The Urllastaccessed Schema",
              "default": "",
              "examples": [
                "2018-11-19"
              ],
              "pattern": "^(.*)$"
            },
            "goal": {
              "$id": "#/items/properties/trainings/items/properties/goal",
              "type": "string",
              "title": "The Goal Schema",
              "default": "",
              "examples": [
                "The goal of this training is to introduce the terms and basic concepts of creating a website with HTML."
              ],
              "pattern": "^(.*)$"
            },
            "length": {
              "$id": "#/items/properties/trainings/items/properties/length",
              "type": "integer",
              "title": "The Length Schema",
              "default": 0,
              "examples": [
                "300"
              ],
              "pattern": "^(.*)$"
            },
            "language": {
              "$id": "#/items/properties/trainings/items/properties/language",
              "type": "string",
              "title": "The Language Schema",
              "default": "",
              "examples": [
                "en"
              ],
              "pattern": "^(..|many)$"
            }
          }
        }
      },
      "reusability": {
        "type": "string",
        "title": "The Reusability Schema",
        "enum": [
          "transversal",
          "cross-sectoral",
          "sector-specific",
          "occupation-specific"
        ]
      },
      "skillId": {
        "type": "string",
        "title": "The SkillId Schema"
      },
      "relationships": {
        "type": "array",
        "title": "The Relationships Schema",
        "items": {
          "type": "object",
          "properties": {
            "skillName": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "prerequisite",
                "complement",
                "substitute",
                "specializes",
                "adjacent"
              ]
            }
          }
        }
      },
      "crosswalks": {
        "type": "object",
        "title": "The Crosswalks Schema",
        "properties": {
          "esco": {
            "type": "string"
          },
          "onet": {
            "type": "string"
          },
          "sfia": {
            "type": "string"
          },
          "lightcast": {
            "type": "string"
          }
        }
      },
      "temporal": {
        "type": "object",
        "title": "The Temporal Schema",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "emerging",
              "growing",
              "mature",
              "declining"
            ]
          },
          "demand_score": {
            "type": "number"
          },
          "growth_rate": {
            "type": "number"
          },
          "emergence_date": {
            "type": "string"
          }
        }
      }
    }
  }
}
